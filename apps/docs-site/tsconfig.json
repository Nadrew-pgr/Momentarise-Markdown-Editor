{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "composite": false,
    "incremental": true,
    "jsx": "preserve",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noEmitOnError": false,
    "resolveJsonModule": true,
    "rootDir": "../..",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.d.mts"
  ],
  "references": [
    {
      "path": "../../packages/md-editor"
    },
    {
      "path": "../../packages/md-render-html"
    },
    {
      "path": "../../packages/md-save"
    },
    {
      "path": "../../packages/md-source-codemirror"
    },
    {
      "path": "../../packages/md-theme"
    }
  ]
}
