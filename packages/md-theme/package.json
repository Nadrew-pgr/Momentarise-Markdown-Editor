{
  "name": "@momentarise/md-theme",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "Design tokens, host theme contract, and icon set contract for Momentarise Markdown Editor.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nadrew-pgr/Momentarise-Markdown-Editor.git",
    "directory": "packages/md-theme"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "markdown",
    "editor",
    "momentarise",
    "theme",
    "tokens"
  ],
  "sideEffects": [
    "./src/tokens.css",
    "./src/styles.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "src/tokens.css",
    "src/styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/copy-package-license.mjs && tsc -b --force"
  },
  "momentarise": {
    "releaseStatus": "experimental",
    "versionPolicy": "0.x semver: public APIs are versioned, and breaking changes may ship in minor releases until 1.0. See docs/public/compatibility-promise.md."
  }
}
