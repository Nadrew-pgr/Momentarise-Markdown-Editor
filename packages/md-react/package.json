{
  "name": "@momentarise/md-react",
  "version": "0.1.0-alpha.3",
  "type": "module",
  "description": "Thin React binding for Momentarise Markdown Editor sessions and DOM surface.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nadrew-pgr/Momentarise-Markdown-Editor.git",
    "directory": "packages/md-react"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "markdown",
    "editor",
    "momentarise",
    "react"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/copy-package-license.mjs && tsc -b --force"
  },
  "dependencies": {
    "@momentarise/md-core": "^0.1.0-alpha.3",
    "@momentarise/md-editor": "^0.1.0-alpha.3",
    "@momentarise/md-save": "^0.1.0-alpha.3",
    "@momentarise/md-source-codemirror": "^0.1.0-alpha.3",
    "@momentarise/md-surface": "^0.1.0-alpha.3",
    "@momentarise/md-theme": "^0.1.0-alpha.3"
  },
  "peerDependencies": {
    "@momentarise/md-rich-prosemirror": "^0.1.0-alpha.3",
    "prosemirror-view": "^1.0.0",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@momentarise/md-rich-prosemirror": {
      "optional": true
    },
    "prosemirror-view": {
      "optional": true
    }
  },
  "devDependencies": {
    "@momentarise/md-rich-prosemirror": "^0.1.0-alpha.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "momentarise": {
    "releaseStatus": "experimental",
    "versionPolicy": "0.x semver: public APIs are versioned, and breaking changes may ship in minor releases until 1.0. See docs/public/compatibility-promise.md."
  }
}
