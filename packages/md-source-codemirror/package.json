{
  "name": "@momentarise/md-source-codemirror",
  "version": "0.1.0-alpha.3",
  "type": "module",
  "description": "Reusable CodeMirror source-mode baseline for Momentarise Markdown Editor.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nadrew-pgr/Momentarise-Markdown-Editor.git",
    "directory": "packages/md-source-codemirror"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "markdown",
    "editor",
    "momentarise",
    "codemirror"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/copy-package-license.mjs && tsc -b --force"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.0"
  },
  "momentarise": {
    "releaseStatus": "experimental",
    "versionPolicy": "0.x semver: public APIs are versioned, and breaking changes may ship in minor releases until 1.0. See docs/public/compatibility-promise.md."
  }
}
