{
  "name": "@momentarise/md-format",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "Parser and serializer contracts for Momentarise Markdown Editor.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nadrew-pgr/Momentarise-Markdown-Editor.git",
    "directory": "packages/md-format"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "markdown",
    "editor",
    "momentarise",
    "parser",
    "serializer"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/copy-package-license.mjs && tsc -b --force"
  },
  "dependencies": {
    "@momentarise/md-core": "^0.1.0-alpha.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1"
  },
  "momentarise": {
    "releaseStatus": "experimental",
    "versionPolicy": "0.x semver: public APIs are versioned, and breaking changes may ship in minor releases until 1.0. See docs/public/compatibility-promise.md."
  }
}
